#!/usr/bin/env python3
"""golink — personal go-links resolver + CLI."""
import json
import os
from pathlib import Path
from urllib.parse import urlsplit

LINKS_PATH = Path.home() / ".golinks" / "links.json"


def load_links(path: Path) -> dict:
    try:
        text = Path(path).read_text()
    except FileNotFoundError:
        return {}
    text = text.strip()
    if not text:
        return {}
    return json.loads(text)


def save_links(path: Path, links: dict) -> None:
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(links, indent=2, sort_keys=True) + "\n")
    _keep_owner(tmp, path)
    os.replace(tmp, path)


def _keep_owner(tmp: Path, path: Path) -> None:
    """Keep the store owned by the human, not by the root daemon.

    The resolver runs as root (port 80) and rewrites this file, which would
    otherwise leave it root-owned and unwritable from the CLI.
    """
    try:
        ref = path if path.exists() else path.parent
        st = ref.stat()
        if os.geteuid() == 0:
            os.chown(tmp, st.st_uid, st.st_gid)
    except (OSError, AttributeError):
        pass  # best effort


ALIAS_PREFIX = "go/"


def _alias_body(value):
    """The part after `go/` if `value` names another link, else None.

    Accepts every spelling the UI invites: `go/x`, `http://go/x`, `//go/x`
    and a bare `/x`.
    """
    if not isinstance(value, str):
        return None
    v = value.strip()
    for prefix in ("https://", "http://", "//"):
        if v.startswith(prefix):
            v = v[len(prefix):]
            break
    if v.startswith(ALIAS_PREFIX):
        return v[len(ALIAS_PREFIX):].strip("/")
    if v.startswith("/") and "//" not in v:
        return v.strip("/")
    return None


def is_alias(value) -> bool:
    """An alias entry stores `go/<other-name>` instead of a URL."""
    return _alias_body(value) is not None


def alias_target(value: str) -> str:
    """The link name an alias points at."""
    return _alias_body(value)


def _norm_url(url: str) -> str:
    return url.strip().rstrip("/")


def as_alias_input(links: dict, value: str, adding: str = None):
    """Read what was typed in the URL box as an alias, or None if it's a URL.

    Accepts `go/x`, `http://go/x`, `/x`, and a bare `x` that names a link you
    already have — a bare token can't be confused with a URL, since a real one
    has a scheme or a dot in it.
    """
    body = _alias_body(value)
    if body is None:
        v = value.strip().strip("/")
        if v and v != adding and "." not in v and ":" not in v and v in links:
            body = v
    return body or None


def canonical_name(links: dict, name: str, _depth: int = 0):
    """Follow an alias chain to the real link name (None if it dangles)."""
    seen = set()
    while name in links and is_alias(links[name]):
        if name in seen:
            return None  # alias cycle
        seen.add(name)
        name = alias_target(links[name])
    return name if name in links else None


def aliases_for(links: dict, name: str) -> list:
    """Names that resolve to `name` through one or more alias hops."""
    return sorted(k for k, v in links.items()
                  if is_alias(v) and canonical_name(links, k) == name)


def link_with_url(links: dict, url: str, exclude: str = None):
    """An existing (non-alias) link already pointing at `url`, if there is one.

    Adding a duplicate target folds into an alias instead of a second entry,
    so the two names stay in sync from then on. Shortest name wins, since
    that's the one most likely to be the "real" name.
    """
    target = _norm_url(url)
    hits = [k for k, v in links.items()
            if k != exclude and not is_alias(v) and _norm_url(v) == target]
    if not hits:
        return None
    # A link that already owns aliases keeps them; otherwise the shortest name.
    return min(hits, key=lambda k: (0 if aliases_for(links, k) else 1, len(k), k))


def _match_key(links: dict, path: str):
    """Longest link name (which may contain '/') that prefixes the request.

    Returns (key, leftover_segments) or (None, None). This lets a link define
    specific sub-commands (go/doc/quant) while any link without a matching sub
    still passes arbitrary trailing segments through to its base (go/gh/<x>).
    The most specific — longest — matching key wins.
    """
    segments = [s for s in urlsplit(path).path.split("/") if s != ""]
    for i in range(len(segments), 0, -1):
        key = "/".join(segments[:i])
        if key in links:
            return key, segments[i:]
    return None, None


def resolve(links: dict, path: str, _depth: int = 0):
    key, rest = _match_key(links, path)
    if key is None:
        return None
    if is_alias(links[key]):
        if _depth > 10:
            return None  # alias cycle
        # Re-resolve under the canonical name so its own sub-links apply:
        # go/76270/markel behaves exactly like go/76-270/markel.
        sub = "/".join([alias_target(links[key])] + list(rest))
        query = urlsplit(path).query
        return resolve(links, "/" + sub + ("?" + query if query else ""), _depth + 1)
    target = links[key].rstrip("/")
    if rest:
        target = target + "/" + "/".join(rest)
    query = urlsplit(path).query
    if query:
        target = target + "?" + query
    return target


def matched_key(links: dict, path: str):
    """The link name a request resolves to (used for usage counting), or None.

    Hits through an alias are credited to the canonical link, so go/76270 and
    go/76-270 share one count.
    """
    key, rest = _match_key(links, path)
    if key is None or not is_alias(links[key]):
        return key
    sub = "/".join([alias_target(links[key])] + list(rest))
    return matched_key(links, "/" + sub) if canonical_name(links, key) else None


def counts_path_for(links_path) -> Path:
    """Usage-count file, kept beside the links store."""
    return Path(links_path).with_name("stats.json")


def load_counts(path) -> dict:
    return load_links(path)  # same JSON-dict format; {} if missing


def bump_count(links_path, name: str) -> None:
    cpath = counts_path_for(links_path)
    counts = load_counts(cpath)
    counts[name] = counts.get(name, 0) + 1
    save_links(cpath, counts)


