# Reserved paths carry a leading underscore so they can't shadow a real link.
OPENSEARCH_PATH = "/_opensearch.xml"
SUGGEST_PATH = "/_suggest"

OPENSEARCH_XML = """<?xml version="1.0" encoding="UTF-8"?>
<OpenSearchDescription xmlns="http://a9.com/-/spec/opensearch/1.1/">
 <ShortName>go</ShortName>
 <Description>go links</Description>
 <InputEncoding>UTF-8</InputEncoding>
 <Url type="text/html" method="get" template="http://go/{searchTerms}"/>
 <Url type="application/x-suggestions+json" method="get"
  template="http://go%s?q={searchTerms}"/>
 <moz:SearchForm xmlns:moz="http://www.mozilla.org/2006/browser/search/"
  >http://go/</moz:SearchForm>
</OpenSearchDescription>
""" % SUGGEST_PATH


def suggest(links: dict, counts: dict, q: str, limit: int = 10) -> list:
    """OpenSearch JSON suggestions: [query, [names], [targets], []].

    Names that start with the query come first, then names containing it;
    within each, the most-used links win. Aliases are offered like any other
    name — typing "76" should reach the course whichever way you spell it.
    """
    q = q.strip().lstrip("/").lower()
    starts, contains = [], []
    for name in links:
        low = name.lower()
        if q and low.startswith(q):
            starts.append(name)
        elif q and q in low:
            contains.append(name)
        elif not q:
            starts.append(name)

    def rank(name):
        canon = canonical_name(links, name) or name
        return (-counts.get(canon, 0), len(name), name)

    names = sorted(starts, key=rank) + sorted(contains, key=rank)
    names = names[:limit]
    targets = [resolve(links, "/" + n) or "" for n in names]
    return [q, names, targets, []]


