#!/usr/bin/env python3
"""golink — personal go-links resolver + CLI."""
import json
import os
from pathlib import Path
from urllib.parse import urlsplit

LINKS_PATH = Path.home() / ".golinks" / "links.json"


def load_links(path: Path) -> dict:
    try:
        text = Path(path).read_text()
    except FileNotFoundError:
        return {}
    text = text.strip()
    if not text:
        return {}
    return json.loads(text)


def save_links(path: Path, links: dict) -> None:
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(links, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, path)


def resolve(links: dict, path: str):
    split = urlsplit(path)
    segments = [s for s in split.path.split("/") if s != ""]
    if not segments:
        return None
    name = segments[0]
    if name not in links:
        return None
    target = links[name].rstrip("/")
    rest = segments[1:]
    if rest:
        target = target + "/" + "/".join(rest)
    if split.query:
        target = target + "?" + split.query
    return target


def link_name(path: str):
    """First path segment of a request (the go-link name), or None."""
    segments = [s for s in urlsplit(path).path.split("/") if s != ""]
    return segments[0] if segments else None


def counts_path_for(links_path) -> Path:
    """Usage-count file, kept beside the links store."""
    return Path(links_path).with_name("stats.json")


def load_counts(path) -> dict:
    return load_links(path)  # same JSON-dict format; {} if missing


def bump_count(links_path, name: str) -> None:
    cpath = counts_path_for(links_path)
    counts = load_counts(cpath)
    counts[name] = counts.get(name, 0) + 1
    save_links(cpath, counts)


