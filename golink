def _display_url(url: str) -> str:
    """Trim scheme and trailing slash so targets read cleanly in the list."""
    for scheme in ("https://", "http://"):
        if url.startswith(scheme):
            url = url[len(scheme):]
            break
    return url.rstrip("/")


def _alias_chips(links: dict, name: str) -> str:
    """The `also go/x go/y` line shown under a link that has aliases."""
    names = aliases_for(links, name)
    if not names:
        return ""
    chips = ""
    for a in names:
        a_esc = html.escape(a)
        chips += (
            f'<span class="chip">go/{a_esc}'
            '<form class="del" method="post" action="/delete">'
            f'<input type="hidden" name="name" value="{a_esc}">'
            f'<button type="submit" aria-label="Remove alias go/{a_esc}" '
            'title="Remove alias">&times;</button></form></span>'
        )
    indent = name.count("/") * 16
    return (f'<span class="aka" style="padding-left:{indent}px">'
            f'<span class="lbl">also</span>{chips}</span>')


def _render(links: dict, counts: dict) -> bytes:
    n = sum(1 for v in links.values() if not is_alias(v))
    n_alias = sum(1 for k, v in links.items()
                  if is_alias(v) and canonical_name(links, k))
    sub = f'<p class="sub"><b id="count">{n}</b> shortcut{"" if n == 1 else "s"}'
    if n_alias:
        sub += f' &middot; <b>{n_alias}</b> alias{"" if n_alias == 1 else "es"}'
    sub += '</p>'
    if not links:
        middle = sub + '<p class="empty">No shortcuts yet. Add one below.</p>'
        return (PAGE_HEAD + middle + PAGE_FOOT).encode()

    rows = ""
    for name in sorted(links):
        value = links[name]
        if is_alias(value):
            if canonical_name(links, name):
                continue  # shown as a chip under its canonical link
            # Dangling alias — surface it so it can be fixed or deleted.
            n_esc = html.escape(name)
            tgt = html.escape(alias_target(value))
            search = html.escape((name + " " + tgt).lower(), quote=True)
            rows += (
                f'<li class="row" data-name="{n_esc}" data-search="{search}">'
                f'<span class="name"><span class="go">go/</span>{n_esc}</span>'
                f'<span class="target broken">alias to go/{tgt} (missing)</span>'
                '<span class="hits zero">0</span>'
                '<form class="del" method="post" action="/delete">'
                f'<input type="hidden" name="name" value="{n_esc}">'
                f'<button type="submit" aria-label="Delete go/{n_esc}">&times;</button>'
                '</form></li>'
            )
            continue
        c = counts.get(name, 0)
        n_esc = html.escape(name)
        disp = _display_url(value)
        akas = aliases_for(links, name)
        search = html.escape((" ".join([name] + akas) + " " + disp).lower(), quote=True)
        indent = name.count("/") * 16
        rows += (
            f'<li class="row" data-name="{n_esc}" data-search="{search}">'
            f'<a class="name" href="{html.escape(links[name])}" style="margin-left:{indent}px">'
            f'<span class="go">go/</span>{n_esc}</a>'
            f'<span class="target">{html.escape(disp)}</span>'
            f'<span class="hits{" zero" if c == 0 else ""}">{c}</span>'
            f'<button class="copy" type="button" data-copy="{html.escape(links[name])}" '
            f'aria-label="Copy link for go/{n_esc}" title="Copy link">{COPY_SVG}</button>'
            '<form class="del" method="post" action="/delete">'
            f'<input type="hidden" name="name" value="{n_esc}">'
            f'<button type="submit" aria-label="Delete go/{n_esc}">&times;</button>'
            '</form>' + _alias_chips(links, name) + '</li>'
        )
    middle = (sub + f'<ul class="rows">{rows}</ul>'
              '<p class="empty" id="nomatch" style="display:none">No matches.</p>')
    return (PAGE_HEAD + middle + PAGE_FOOT).encode()


def make_handler(links_path):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def _redirect(self, location, code=302):
            self.send_response(code)
            self.send_header("Location", location)
            self.end_headers()

        def _send(self, body: bytes, ctype: str, code: int = 200):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            links = load_links(links_path)
            path_only = urlsplit(self.path).path
            if path_only == OPENSEARCH_PATH:
                self._send(OPENSEARCH_XML.encode(),
                           "application/opensearchdescription+xml")
                return
            if path_only == SUGGEST_PATH:
                q = parse_qs(urlsplit(self.path).query).get("q", [""])[0]
                counts = load_counts(counts_path_for(links_path))
                body = json.dumps(suggest(links, counts, q)).encode()
                self._send(body, "application/x-suggestions+json")
                return
            if self.path == "/" or self.path.startswith("/?"):
                counts = load_counts(counts_path_for(links_path))
                body = _render(links, counts)
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            target = resolve(links, self.path)
            if target is None:
                msg = b"404 no such go link\n"
                self.send_response(404)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(msg)))
                self.end_headers()
                self.wfile.write(msg)
                return
            bump_count(links_path, matched_key(links, self.path))
            self._redirect(target, 302)

        def _read_form(self):
            length = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(length).decode()
            return {k: v[0] for k, v in parse_qs(raw).items()}

        def do_POST(self):
            form = self._read_form()
            links = load_links(links_path)
            if self.path == "/delete":
                links.pop(form.get("name", ""), None)
                save_links(links_path, links)
                self._redirect("/", 303)
                return
            name = form.get("name", "").strip().strip("/")
            url = form.get("url", "").strip()
            if name and url:
                typed_alias = as_alias_input(links, url, adding=name)
                if typed_alias:
                    url = ALIAS_PREFIX + typed_alias
                if is_alias(url) and alias_target(url) == name:
                    self._redirect("/", 303)  # refuse a self-alias
                    return
                twin = link_with_url(links, url, exclude=name)
                if twin and not is_alias(url):
                    url = ALIAS_PREFIX + twin  # same target -> alias, not a copy
                links[name] = url
                save_links(links_path, links)
            self._redirect("/", 303)

    return Handler


def serve(host: str, port: int, links_path) -> None:
    # Threaded: a browser that opens a socket speculatively (Chrome preconnect)
    # would otherwise block every later request on a single-threaded server.
    httpd = ThreadingHTTPServer((host, port), make_handler(links_path))
    httpd.daemon_threads = True
    httpd.serve_forever()


import argparse
import sys


def cmd_add(args):
    name = args.name.strip("/")
    url = args.url.strip()
    links = load_links(args.links)
    typed_alias = as_alias_input(links, url, adding=name)
    if typed_alias:
        url = ALIAS_PREFIX + typed_alias
    if is_alias(url):
        return _set_alias(args.links, links, name, alias_target(url))
    twin = link_with_url(links, url, exclude=name)
    if twin:
        return _set_alias(args.links, links, name, twin)
    links[name] = url
    save_links(args.links, links)
    print(f"added {name} -> {url}")
    return 0


def _set_alias(links_path, links: dict, name: str, target: str) -> int:
    """Point `name` at an existing link `target`."""
    target = target.strip()
    if target.startswith(ALIAS_PREFIX):
        target = target[len(ALIAS_PREFIX):]
    target = target.strip("/")
    if name == target:
        print(f"{name} cannot alias itself", file=sys.stderr)
        return 1
    if target not in links:
        print(f"no such link to alias: {target}", file=sys.stderr)
        return 1
    links[name] = ALIAS_PREFIX + target
    if canonical_name(links, name) is None:
        print(f"{name} -> {target} would make an alias cycle", file=sys.stderr)
        return 1
    save_links(links_path, links)
    print(f"aliased {name} -> go/{target}")
    return 0


def cmd_alias(args):
    links = load_links(args.links)
    return _set_alias(args.links, links, args.name.strip("/"), args.target)


def cmd_rm(args):
    links = load_links(args.links)
    if links.pop(args.name, None) is None:
        print(f"no such link: {args.name}", file=sys.stderr)
        return 1
    save_links(args.links, links)
    cpath = counts_path_for(args.links)
    counts = load_counts(cpath)
    if counts.pop(args.name, None) is not None:
        save_links(cpath, counts)
    print(f"removed {args.name}")
    return 0


def cmd_list(args):
    links = load_links(args.links)
    if not links:
        print("(no links)")
        return 0
    counts = load_counts(counts_path_for(args.links))
    width = max(len(n) for n in links)
    for name in sorted(links):
        value = links[name]
        if is_alias(value):
            if canonical_name(links, name):
                continue  # listed under its canonical link
            print(f"{name.ljust(width)} {'':5}  -> go/{alias_target(value)} (missing)")
            continue
        hits = str(counts.get(name, 0)).rjust(5)
        print(f"{name.ljust(width)} {hits}  {value}")
        for a in aliases_for(links, name):
            print(f"{' ' * width} {'':5}  aka go/{a}")
    return 0


def cmd_serve(args):
    serve(args.host, args.port, args.links)
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="golink", description="personal go-links")
    p.add_argument("--links", type=Path, default=LINKS_PATH,
                   help="path to links.json")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="add or update a link")
    a.add_argument("name")
    a.add_argument("url")
    a.set_defaults(func=cmd_add)

    r = sub.add_parser("rm", help="remove a link")
    r.add_argument("name")
    r.set_defaults(func=cmd_rm)

    al = sub.add_parser("alias", help="point a second name at an existing link")
    al.add_argument("name")
    al.add_argument("target", help="existing link name (go/ prefix optional)")
    al.set_defaults(func=cmd_alias)

    l = sub.add_parser("list", help="list links")
    l.set_defaults(func=cmd_list)

    s = sub.add_parser("serve", help="run the resolver server")
    s.add_argument("--host", default="127.0.0.1")
    s.add_argument("--port", type=int, default=80)
    s.set_defaults(func=cmd_serve)

    ins = sub.add_parser("install", help="install hosts entry + launchd daemon (sudo)")
    ins.set_defaults(func=cmd_install)

    uns = sub.add_parser("uninstall", help="remove hosts entry + launchd daemon (sudo)")
    uns.set_defaults(func=cmd_uninstall)

    return p


import subprocess
import pwd

HOSTS_PATH = Path("/etc/hosts")
PLIST_LABEL = "com.bryan.golink"
PLIST_PATH = Path("/Library/LaunchDaemons/com.bryan.golink.plist")
HOSTS_MARKER = "# golink"
HOSTS_LINE = "127.0.0.1\tgo # golink"


def hosts_with_entry(current: str) -> str:
    lines = [ln for ln in current.splitlines() if HOSTS_MARKER not in ln]
    lines.append(HOSTS_LINE)
    return "\n".join(lines) + "\n"


def hosts_without_entry(current: str) -> str:
    lines = [ln for ln in current.splitlines() if HOSTS_MARKER not in ln]
    return "\n".join(lines) + "\n"


def plist_contents(script_path: Path, links_path: Path) -> str:
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{PLIST_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{sys.executable}</string>
    <string>{script_path}</string>
    <string>--links</string><string>{links_path}</string>
    <string>serve</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>80</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/golink.err.log</string>
  <key>StandardOutPath</key><string>/tmp/golink.out.log</string>
</dict></plist>
"""


def _real_links_path(args):
    """Resolve the links path for the *invoking* user, even under sudo.

    When `install` runs via sudo and --links was left at the default (which
    points at root's home), redirect it to the real user's ~/.golinks.
    """
    if args.links != LINKS_PATH:
        return args.links  # user gave an explicit path; respect it
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        home = Path(pwd.getpwnam(sudo_user).pw_dir)
        return home / ".golinks" / "links.json"
    return args.links


def cmd_install(args):
    script_path = Path(__file__).resolve()
    links_path = _real_links_path(args)
    # 1. hosts entry
    HOSTS_PATH.write_text(hosts_with_entry(HOSTS_PATH.read_text()))
    # 2. plist
    PLIST_PATH.write_text(plist_contents(script_path, links_path))
    subprocess.run(["launchctl", "unload", str(PLIST_PATH)], capture_output=True)
    subprocess.run(["launchctl", "load", str(PLIST_PATH)], check=True)
    print(f"installed. resolver reads {links_path}")
    print("go links are live — try go/<name> in a browser.")
    return 0


def cmd_uninstall(args):
    subprocess.run(["launchctl", "unload", str(PLIST_PATH)], capture_output=True)
    if PLIST_PATH.exists():
        PLIST_PATH.unlink()
    if HOSTS_PATH.exists():
        HOSTS_PATH.write_text(hosts_without_entry(HOSTS_PATH.read_text()))
    print("uninstalled. links.json left intact.")
    return 0


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
